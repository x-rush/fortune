# 生产环境配置
VITE_API_URL=/api
VITE_APP_TITLE=indexoob

# 服务器配置 - 请在生产环境中修改这些值
ADMIN_USERNAME=your_production_admin_username
ADMIN_PASSWORD=your_strong_production_password
JWT_SECRET=your_super_secure_jwt_secret_key_change_this_in_production

# 端口配置
PORT=3001

# 安全提示：
# 1. 请将 ADMIN_USERNAME 和 ADMIN_PASSWORD 修改为强密码
# 2. JWT_SECRET 必须是一个复杂的随机字符串
# 3. 不要使用默认值或弱密码
# 4. 定期更换密码和密钥